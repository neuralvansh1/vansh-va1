# Optional verified-email provider. If absent, the endpoint uses FormSubmit.
# FormSubmit needs its one-time confirmation email activated by the owner.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=

# Optional automatic WhatsApp notification to the site owner.
# Requires an active Meta WhatsApp Business sender and approved utility template.
# The template body must have four text parameters: name, email, service, message.
# Set the currently supported Graph API version for that account, e.g. vNN.0.
WHATSAPP_NOTIFY_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=
